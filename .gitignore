# ============================================================
# Customer 360 — .gitignore
# ============================================================

# --- Configuración con credenciales (NUNCA subir) ---
config/database.local.php
.env
.env.local
.env.*.local

# --- Dependencias ---
/vendor/
node_modules/

# --- Logs ---
*.log
logs/
*.log.*

# --- Backups de base de datos ---
*.sql.gz
*.sql.bak
*.sql.zip
backups/

# --- Archivos del sistema operativo ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# --- IDE / Editor ---
.vscode/
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Temporales ---
*.tmp
*.temp
*.bak
*.orig
*.cache
.cache/

# --- Archivos de compilación ---
dist/
build/
*.min.js.map
*.min.css.map

# --- Pruebas ---
coverage/
.phpunit.result.cache

# --- Archivos de configuración personal ---
*.local
*.local.php
!config/database.local.php.example

# --- Carpeta de docs generados (opcional) ---
docs/_build/
docs/_site/

# Configuración de IA con credenciales
config/ai.local.php

# ============================================================
# Variables de entorno
# ============================================================
.env
.env.local
.env.*.local
!.env.example