# ============================================================
# Customer 360 — Variables de Entorno
# ============================================================
# Copia este archivo como .env y edita los valores.
#
#   cp .env.example .env
#
# ⚠️ IMPORTANTE: el archivo .env NUNCA se sube a Git
# (ya está protegido en .gitignore)
# ============================================================

# ============================================================
# APLICACIÓN
# ============================================================
APP_NAME="Customer 360"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/customer360
APP_TIMEZONE=America/Mexico_City
APP_LANG=es

# ============================================================
# BASE DE DATOS (MySQL / MariaDB)
# ============================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=customer360
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# ⚠️ NOTA: en XAMPP, MySQL a veces usa puertos distintos (3307, 3308).
# Verifica el puerto en el panel de XAMPP Control Panel.

# ============================================================
# IA GENERATIVA — Groq (https://console.groq.com)
# ============================================================
# Obtén tu clave gratuita en: https://console.groq.com/keys
GROQ_API_KEY=gsk_TU_CLAVE_AQUI
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_CACHE_TTL_HOURS=24

# ============================================================
# SESIONES
# ============================================================
SESSION_LIFETIME_HOURS=8
SESSION_NAME=CUSTOMER360_SESSION

# ============================================================
# SEGURIDAD
# ============================================================
# Cambia este valor en producción
APP_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria
BCRYPT_COST=10

# ============================================================
# NOTIFICACIONES
# ============================================================
NOTIFICATIONS_REFRESH_SECONDS=60
NOTIFICATIONS_MAX=15

# ============================================================
# LOGS
# ============================================================
LOG_LEVEL=info
LOG_CHANNEL=file
LOG_PATH=logs/